# Supabase · cliente público (seguro para el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# También podés usar la clave publicable nueva en lugar de la anon key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública del sitio para confirmación, recuperación y enlaces de calendario.
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sólo para scripts de prueba locales (NUNCA en el navegador ni en NEXT_PUBLIC_*).
# Si se define, el script crea y elimina usuarios de prueba automáticamente.
# SUPABASE_SERVICE_ROLE_KEY=
